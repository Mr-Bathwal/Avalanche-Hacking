# Copy this file to `.env` and adjust as needed.
# Everything here is OPTIONAL — the app ships with sensible public defaults,
# so it runs out of the box without a .env file.

# Avalanche Fuji C-Chain RPC endpoint.
# Default: the public Avalanche RPC (no key required).
VITE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# WalletConnect Cloud project id — https://cloud.walletconnect.com
# Needed only if you want your own WalletConnect project instead of the demo one.
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Optional override for the EventFactory contract address.
# Defaults to the deployed address in src/lib/contracts.js.
VITE_EVENT_FACTORY_ADDRESS=0xBdfD55f12efCBd84Fc5851b7e9E1931b5381edBe
